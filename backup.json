put}}","params":[{"key":"input","label":"待摘要内容","type":"textarea"}],"builtin":true,"enabled":true,"sort_order":30,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"},{"id":4,"slug":"translate","name":"中英互译","description":"在中文与英文之间互译，保留术语与格式。","category":"文本","icon":"globe","capability":"chat","prompt":"把下面的内容翻译成{{target}}。要求：保留原有的 Markdown 结构与专业术语，只输出译文。\n\n{{input}}","params":[{"key":"input","label":"原文","type":"textarea"},{"key":"target","label":"目标语言","type":"select","default":"英文","options":["英文","中文"]}],"builtin":true,"enabled":true,"sort_order":40,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"},{"id":5,"slug":"extract-json","name":"结构化抽取","description":"按给定字段把自由文本抽取成严格 JSON。","category":"文本","icon":"braces","capability":"chat","prompt":"从下面的文本中抽取信息，输出严格合法的 JSON（不要包裹代码块、不要附加解释）。\n需要的字段：{{fields}}\n\n文本：\n{{input}}","params":[{"key":"input","label":"文本","type":"textarea"},{"key":"fields","label":"字段列表","type":"text","placeholder":"name, company, amount"}],"builtin":true,"enabled":true,"sort_order":50,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"},{"id":6,"slug":"image-prompt","name":"绘图提示词优化","description":"把一句话想法扩写成结构化的文生图提示词。","category":"图片","icon":"image","capability":"chat","prompt":"你是文生图提示词工程师。把下面的想法扩写成一条高质量提示词，包含主体、构图、光线、材质、镜头与风格。\n只输出提示词本身（英文），不要解释。\n\n想法：{{input}}","params":[{"key":"input","label":"想法","type":"textarea"}],"builtin":true,"enabled":true,"sort_order":60,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"},{"id":7,"slug":"storyboard","name":"视频分镜脚本","description":"把主题拆成可直接投喂视频模型的分镜提示词列表。","category":"视频","icon":"film","capability":"chat","prompt":"请为主题「{{input}}」设计 {{shots}} 个镜头的分镜脚本。\n每个镜头输出：镜头号 / 画面描述（英文，适合视频生成模型）/ 时长（秒）/ 运镜方式。\n总时长控制在 {{duration}} 秒以内。","params":[{"key":"input","label":"主题","type":"text"},{"key":"shots","label":"镜头数","type":"number","default":"4"},{"key":"duration","label":"总时长（秒）","type":"number","default":"20"}],"builtin":true,"enabled":true,"sort_order":70,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"},{"id":8,"slug":"video-prompt","name":"视频提示词增强","description":"把口语描述改写成视频模型易理解的英文提示词。","category":"视频","icon":"sparkles","capability":"chat","prompt":"把下面的描述改写成一条适合视频生成模型的英文提示词。包含：主体动作、镜头运动、环境光线、画面风格。\n只输出提示词本身。\n\n描述：{{input}}","params":[{"key":"input","label":"描述","type":"textarea"}],"builtin":true,"enabled":true,"sort_order":80,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"},{"id":9,"slug":"image-card","name":"文生图直出","description":"不经过对话模型，直接把提示词投给图片模型。","category":"图片","icon":"image","capability":"image","prompt":"{{input}}","params":[{"key":"input","label":"图片提示词","type":"textarea"},{"key":"size","label":"尺寸","type":"select","default":"1024x1024","options":["1024x1024","1536x1024","1024x1536","512x512"]}],"builtin":true,"enabled":true,"sort_order":90,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"},{"id":10,"slug":"video-card","name":"文生视频直出","description":"直接把提示词投给视频模型，创建生成任务。","category":"视频","icon":"film","capability":"video","prompt":"{{input}}","params":[{"key":"input","label":"视频提示词","type":"textarea"},{"key":"duration","label":"时长（秒）","type":"number","default":"5"}],"builtin":true,"enabled":true,"sort_order":100,"created_at":"2026-09-25T22:14:47+08:00","updated_at":"2026-09-25T22:14:47+08:00"}],"catalog":[],"settings":{}}
